{
  "name": "likedex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Likedex Chrome extension foundation",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "postinstall": "wxt prepare",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "verify:storage": "vitest run tests/unit/domain.test.ts tests/unit/storage.test.ts",
    "verify:auth": "vitest run tests/unit/authentication.test.ts tests/unit/authentication-service.test.ts",
    "verify:provider": "vitest run tests/unit/provider-ingestion.test.ts",
    "verify:sync": "vitest run tests/unit/domain.test.ts tests/unit/storage.test.ts tests/unit/provider-ingestion.test.ts tests/unit/synchronization.test.ts tests/unit/synchronization-service.test.ts",
    "verify:runtime": "vitest run tests/unit/runtime.test.ts tests/unit/runtime-observer.test.ts tests/unit/options-runtime.test.ts",
    "verify:ui": "vitest run tests/unit/library-query.test.ts tests/unit/options-presentation.test.tsx tests/unit/sync-progress.test.ts",
    "build": "wxt build -b chrome --mv3",
    "check:build": "node scripts/check-build.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:build && npm run build:provider-validation && npm run check:provider-validation && npm run test:e2e",
    "build:provider-validation": "wxt build -c wxt.validation.config.ts -b chrome --mv3",
    "check:provider-validation": "node scripts/check-provider-validation-build.mjs",
    "verify:provider-validation": "vitest run tests/unit/provider-validation.test.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
